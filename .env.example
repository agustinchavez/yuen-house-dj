# =============================================================
# Yuen House Radio DJ Dashboard — Environment Variables
# Copy this file to .env.local and fill in real values.
# =============================================================

# Database (Prisma reads this from .env, not .env.local)
# For dev:  file:./dev.db
# For prod: file:/srv/radio/db/dashboard.db
DATABASE_URL="file:./dev.db"

# NextAuth
# For dev:  http://localhost:3000
# For prod: https://dj.yuenhouse.org
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# Icecast
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_ADMIN_PASSWORD=your_icecast_admin_password
ICECAST_SOURCE_PASSWORD=your_icecast_source_password

# Public hostname of the stream. DJs point their source client here, and it is
# what the show page shows them as their Mixxx server address.
STREAM_HOSTNAME=radio.yuenhouse.org

# Mount DJs connect to. Must match ICECAST_LIVE_MOUNT in infra/infra.env -
# live-show detection works by looking for this mount in Icecast's stats.
ICECAST_LIVE_MOUNT=live
# Mount listeners hear (Liquidsoap's output)
ICECAST_MOUNT=stream

# Liquidsoap
LIQUIDSOAP_HOST=127.0.0.1
LIQUIDSOAP_PORT=1234
# Must match the request.queue id in infra/liquidsoap/radio.liq.template.
# A mismatch is silent until air time, when the push is rejected.
LIQUIDSOAP_QUEUE=scheduled

# File paths
# For dev:  ./data/uploads, ./data/archive, ./data/fallback
# For prod: /srv/radio/uploads, /srv/radio/archive, /srv/radio/fallback
UPLOADS_DIR=./data/uploads
ARCHIVE_DIR=./data/archive
FALLBACK_DIR=./data/fallback

# Email notifications (optional — emails are skipped if SMTP_HOST is not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Yuen House Radio <noreply@yuenhouse.org>
