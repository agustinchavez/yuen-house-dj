# Copy to infra/infra.env on the server and fill in. Gitignored - holds secrets.

# Hostnames (both must have DNS A records pointing at this server)
DASHBOARD_HOSTNAME=dj.yuenhouse.org
STREAM_HOSTNAME=radio.yuenhouse.org

# Generate with: openssl rand -base64 24
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=

ICECAST_ADMIN_EMAIL=admin@yuenhouse.org

# Defaults are fine unless something else on the box uses these ports
ICECAST_PORT=8000
ICECAST_MOUNT=stream
LIQUIDSOAP_PORT=1234
HARBOR_PORT=8005
