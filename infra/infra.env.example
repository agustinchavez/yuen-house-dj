# Copy to infra/infra.env and fill in the TWO hostnames. That is all that is
# required - everything else has working defaults, and empty passwords are
# generated for you on first run and written back into this file.
# Gitignored: this file holds the station's secrets once rendered.

# Both need DNS A records pointing at this server
DASHBOARD_HOSTNAME=dj.yuenhouse.org
STREAM_HOSTNAME=radio.yuenhouse.org

# Leave blank to auto-generate on first setup.sh run
ICECAST_SOURCE_PASSWORD=
ICECAST_ADMIN_PASSWORD=

# --- optional, defaults are fine --------------------------------------------
ICECAST_ADMIN_EMAIL=admin@yuenhouse.org
ICECAST_PORT=8000
ICECAST_MOUNT=stream
ICECAST_LIVE_MOUNT=live
LIQUIDSOAP_PORT=1234

# --- optional: email notifications to DJs (skipped when SMTP_HOST is unset) --
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Yuen House Radio <noreply@yuenhouse.org>
