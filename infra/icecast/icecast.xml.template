<icecast>
    <!-- Yuen House Radio - Icecast 2 configuration.
         TEMPLATE: rendered by infra/setup.sh with envsubst. Contains passwords;
         the rendered file is chmod 600 and owned by the icecast user. -->

    <location>Chicago, IL</location>
    <admin>${ICECAST_ADMIN_EMAIL}</admin>

    <limits>
        <!-- Sized for a student station. Each listener at 128kbps uses about
             58 MB per hour, so 100 concurrent listeners is ~5.8 GB/hour. Raise
             deliberately: this is the knob that turns into a bandwidth bill. -->
        <clients>100</clients>
        <sources>4</sources>
        <queue-size>524288</queue-size>
        <client-timeout>30</client-timeout>
        <header-timeout>15</header-timeout>
        <source-timeout>10</source-timeout>
        <burst-on-connect>1</burst-on-connect>
        <burst-size>65535</burst-size>
    </limits>

    <authentication>
        <!-- Liquidsoap uses source-password to publish the stream. -->
        <source-password>${ICECAST_SOURCE_PASSWORD}</source-password>
        <relay-password>${ICECAST_SOURCE_PASSWORD}</relay-password>
        <!-- The dashboard reads /admin/stats.xml with these. -->
        <admin-user>admin</admin-user>
        <admin-password>${ICECAST_ADMIN_PASSWORD}</admin-password>
    </authentication>

    <hostname>${STREAM_HOSTNAME}</hostname>

    <listen-socket>
        <!-- Loopback only. Caddy terminates TLS and proxies to this, so the
             stream is reachable as https://<STREAM_HOSTNAME>/ and never on
             plain HTTP. A page served over HTTPS cannot play an HTTP stream. -->
        <bind-address>127.0.0.1</bind-address>
        <port>${ICECAST_PORT}</port>
    </listen-socket>

    <mount type="normal">
        <mount-name>/${ICECAST_MOUNT}</mount-name>
        <stream-name>Yuen House Radio</stream-name>
        <stream-description>UChicago student radio</stream-description>
        <stream-url>https://yuenhouse.org</stream-url>
        <public>0</public>
    </mount>

    <fileserve>1</fileserve>

    <paths>
        <basedir>/usr/share/icecast2</basedir>
        <logdir>/var/log/icecast2</logdir>
        <webroot>/usr/share/icecast2/web</webroot>
        <adminroot>/usr/share/icecast2/admin</adminroot>
        <alias source="/" destination="/status.xsl"/>
    </paths>

    <logging>
        <accesslog>access.log</accesslog>
        <errorlog>error.log</errorlog>
        <loglevel>3</loglevel>
        <logsize>10000</logsize>
    </logging>

    <security>
        <chroot>0</chroot>
        <changeowner>
            <user>icecast2</user>
            <group>icecast</group>
        </changeowner>
    </security>
</icecast>
